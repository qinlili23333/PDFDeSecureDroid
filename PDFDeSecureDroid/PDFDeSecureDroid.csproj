<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<PlatformName>android</PlatformName>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following
		this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is
		maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular
		<RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>PDFDeSecureDroid</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>PDFDeSecureDroid</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>moe.qinlili.pdfdesecuredroid</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">
			android-arm64</RuntimeIdentifiers>
		<Platforms>AnyCPU</Platforms>
		
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<InvariantGlobalization>true</InvariantGlobalization>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<Configurations>Debug;Release;ReleaseAAB</Configurations>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
	  <Optimize>True</Optimize>
	  <DebugType>none</DebugType>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EnableLLVM>False</EnableLLVM>
    <TrimMode>link</TrimMode>
    <AndroidKeyStore>False</AndroidKeyStore>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidEnableMultiDex>False</AndroidEnableMultiDex>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <RunAOTCompilation>True</RunAOTCompilation>
    <PublishTrimmed>True</PublishTrimmed>
    <AndroidUseAapt2>True</AndroidUseAapt2>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='ReleaseAAB'">
	  <Optimize>True</Optimize>
	  <DebugType>none</DebugType>
	  <AndroidPackageFormat>aab</AndroidPackageFormat>
	  <EnableLLVM>False</EnableLLVM>
	  <TrimMode>link</TrimMode>
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <AndroidLinkTool>r8</AndroidLinkTool>
	  <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
	  <AndroidEnableMultiDex>False</AndroidEnableMultiDex>
	  <StackTraceSupport>false</StackTraceSupport>
	  <UseSystemResourceKeys>true</UseSystemResourceKeys>
	  <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
	  <DebuggerSupport>false</DebuggerSupport>
	  <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
	  <RunAOTCompilation>True</RunAOTCompilation>
	  <PublishTrimmed>True</PublishTrimmed>
	  <AndroidUseAapt2>True</AndroidUseAapt2>
    <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-android'))">
      android-arm64;android-arm;android-x86;android-x64
    </RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
	  <Optimize>False</Optimize>
    <EnableLLVM>False</EnableLLVM>
    <TrimMode>link</TrimMode>
    <AndroidKeyStore>False</AndroidKeyStore>
    <AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
    <AndroidEnableMultiDex>False</AndroidEnableMultiDex>
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
    <RunAOTCompilation>True</RunAOTCompilation>
    <PublishTrimmed>True</PublishTrimmed>
    <AndroidUseAapt2>True</AndroidUseAapt2>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>


	
	<ItemGroup>
		<TrimmableAssembly Include="MyAssembly" />
		<TrimmableAssembly Remove="PDFsharp" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />

		<!-- Images -->

		<!-- Custom Fonts -->

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="Resources\Fonts\**" />
	  <AndroidResource Remove="Resources\Images\**" />
	  <Compile Remove="Resources\Fonts\**" />
	  <Compile Remove="Resources\Images\**" />
	  <EmbeddedResource Remove="Resources\Fonts\**" />
	  <EmbeddedResource Remove="Resources\Images\**" />
	  <MauiCss Remove="Resources\Fonts\**" />
	  <MauiCss Remove="Resources\Images\**" />
	  <MauiXaml Remove="Resources\Fonts\**" />
	  <MauiXaml Remove="Resources\Images\**" />
	  <None Remove="Resources\Fonts\**" />
	  <None Remove="Resources\Images\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0-rc.2.25504.7" />
		<PackageReference Include="PDFsharp" Version="6.2.2" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.Maui.Controls.Compatibility" Version="8.0.80" />
	</ItemGroup>

</Project>